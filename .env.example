# Contact form email delivery (Resend — https://resend.com). Without these the form
# honestly reports that it cannot send and offers a mailto: fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=deo.mubashirsohail@gmail.com
# Must be a verified sender in Resend. The default works only for the Resend account owner's email.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
